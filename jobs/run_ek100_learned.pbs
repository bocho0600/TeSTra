#!/bin/bash -l
#PBS -N ek100_learned
#PBS -l select=1:ncpus=4:ngpus=1:mem=128GB:gpu_id=A100
#PBS -l walltime=48:00:00
#PBS -m abe
#PBS -M n11429984@qut.edu.au
#PBS -j oe
#PBS -q gpu_batch_exec

# FULL run: train the LEARNED frame gate on EK100 end-to-end (scorer trained with
# the LSTR cross-entropy + L1 sparsity), then eval it. Checkpoints go in a SESSION
# subdir so they do NOT overwrite the baseline from run_ek100.pbs.
# Run run_ek100_learned_smoke.pbs FIRST to validate cheaply.

REPO_DIR=~/TeSTra
HPC_RUN_DIR=~/hpc_run
CONFIG=configs/EK100/TESTRA/testra_long_64_work_5_anti_2_kinetics_2x_mixup_v+n_eql_box.yaml
CKPT_DIR=checkpoints/EK100/TESTRA/testra_long_64_work_5_anti_2_kinetics_2x_mixup_v+n_eql_box
SESSION=framegate_learned
CKPT=$CKPT_DIR/$SESSION/epoch-30.pth

GATE_OPTS="MODEL.LSTR.FRAME_GATE.ENABLED True MODEL.LSTR.FRAME_GATE.SCORE learned MODEL.LSTR.FRAME_GATE.TOP_K 32"
EVAL_OPTS="DATA_LOADER.BATCH_SIZE 4 DATA_LOADER.NUM_WORKERS 4 DATA_LOADER.PIN_MEMORY False"

cd "$REPO_DIR"
mkdir -p "$REPO_DIR/joblogs"
exec > >(tee -a "$REPO_DIR/joblogs/${PBS_JOBNAME:-ek100}.${PBS_JOBID:-manual}.log") 2>&1
module load Miniconda3
conda activate testra 2>/dev/null || conda activate lstr
export PYTHONPATH=$PYTHONPATH:$(pwd)/src

echo "########## TRAIN: learned frame gate on EK100 (TOP_K=32, sparsity=0.01) ##########"
python tools/train_net.py --config_file "$CONFIG" --gpu 0 \
    $GATE_OPTS MODEL.LSTR.FRAME_GATE.SPARSITY_WEIGHT 0.01 \
    SESSION $SESSION SOLVER.PHASES "['train']"
TRAIN_EXIT=$?

if [ $TRAIN_EXIT -eq 0 ]; then
    echo "########## EVAL: learned frame gate (TOP_K=32) ##########"
    python tools/test_net.py --config_file "$CONFIG" --gpu 0 \
        MODEL.CHECKPOINT "$CKPT" $GATE_OPTS SESSION $SESSION $EVAL_OPTS
else
    echo "Learned-gate training failed (exit $TRAIN_EXIT); skipping eval."
fi

# Push logs (best-effort)
if [ -d "$HPC_RUN_DIR/.git" ]; then
    cd "$HPC_RUN_DIR"
    git add logs/ 2>/dev/null
    git commit -m "logs: $(date +"%Y-%m-%d_%H-%M-%S") job=${PBS_JOBID} exit=${TRAIN_EXIT} (EK100 learned gate)" 2>/dev/null
    git push origin main 2>/dev/null && echo "Logs pushed." || echo "git push failed; push from login node."
fi

exit $TRAIN_EXIT
