#!/bin/bash -l
#PBS -N ek100_lrn_sm
#PBS -l select=1:ncpus=4:ngpus=1:mem=48GB:gpu_id=A100
#PBS -l walltime=06:00:00
#PBS -m abe
#PBS -M n11429984@qut.edu.au
#PBS -j oe
#PBS -q gpu_batch_exec

# SMOKE TEST for the LEARNED frame gate on EK100: train 1 epoch WITH the learned
# gate enabled (so the scorer weights are trained + the sparsity hook runs), then
# eval it. Validates the learned-gate code path before the full run.
# Checkpoints go in a SESSION subdir so they do NOT overwrite the baseline.

REPO_DIR=~/TeSTra
CONFIG=configs/EK100/TESTRA/testra_long_64_work_5_anti_2_kinetics_2x_mixup_v+n_eql_box.yaml
CKPT_DIR=checkpoints/EK100/TESTRA/testra_long_64_work_5_anti_2_kinetics_2x_mixup_v+n_eql_box
SESSION=framegate_learned_smoke
CKPT=$CKPT_DIR/$SESSION/epoch-1.pth

GATE_OPTS="MODEL.LSTR.FRAME_GATE.ENABLED True MODEL.LSTR.FRAME_GATE.SCORE learned MODEL.LSTR.FRAME_GATE.TOP_K 32"
EVAL_OPTS="DATA_LOADER.BATCH_SIZE 4 DATA_LOADER.NUM_WORKERS 4 DATA_LOADER.PIN_MEMORY False"

cd "$REPO_DIR"
module load Miniconda3
conda activate testra 2>/dev/null || conda activate lstr
export PYTHONPATH=$PYTHONPATH:$(pwd)/src

echo "########## SMOKE: train 1 epoch WITH learned gate (+sparsity) ##########"
python tools/train_net.py --config_file "$CONFIG" --gpu 0 \
    $GATE_OPTS MODEL.LSTR.FRAME_GATE.SPARSITY_WEIGHT 0.01 \
    SESSION $SESSION SOLVER.NUM_EPOCHS 1 SOLVER.SAVE_EVERY 1
TRAIN_EXIT=$?

if [ $TRAIN_EXIT -eq 0 ]; then
    echo "########## SMOKE: eval learned gate (1-epoch ckpt) ##########"
    python tools/test_net.py --config_file "$CONFIG" --gpu 0 \
        MODEL.CHECKPOINT "$CKPT" $GATE_OPTS SESSION $SESSION $EVAL_OPTS
    echo "########## LEARNED SMOKE PASSED: scorer trains + evals. Safe to run run_ek100_learned.pbs ##########"
else
    echo "Learned-gate smoke training failed (exit $TRAIN_EXIT); paste the log."
fi

exit $TRAIN_EXIT
