#!/bin/bash -l
#PBS -N ek100_gate
#PBS -l select=1:ncpus=4:ngpus=1:mem=48GB:gpu_id=A100
#PBS -l walltime=48:00:00
#PBS -m abe
#PBS -M n11429984@qut.edu.au
#PBS -j oe
#PBS -q gpu_batch_exec

# EK100 second-dataset run for the pre-embedding frame gate (ported into TeSTra).
#   1. Train ONE baseline (no frame reduction) with TeSTra's EK100 recipe.
#   2. Eval that SAME checkpoint with the gate off (baseline), gate:norm, gate:uniform.
# EK100 long memory is only N=64 frames, so budgets are a FRACTION of 64
# (keep 32 = 50%, keep 16 = 25%), not the ~6% used on THUMOS (N=2048).
#
# PREREQUISITES on the cluster (see jobs/FRAME_GATE_EK100.md):
#   - EK100 features + targets under data/EK100/
#     (rgb_kinetics_bninception, flow_kinetics_bninception, target_perframe,
#      verb_perframe, noun_perframe)
#   - RULSTM data CSVs under external/rulstm/RULSTM/data/ek100/
#     (training.csv, validation.csv, and the verb/noun/action mapping files)

REPO_DIR=~/TeSTra
HPC_RUN_DIR=~/hpc_run

CONFIG=configs/EK100/TESTRA/testra_long_64_work_5_anti_2_kinetics_2x_mixup_v+n_eql_box.yaml
CKPT=checkpoints/EK100/TESTRA/testra_long_64_work_5_anti_2_kinetics_2x_mixup_v+n_eql_box/epoch-30.pth

EVAL_OPTS="DATA_LOADER.BATCH_SIZE 4 DATA_LOADER.NUM_WORKERS 4 DATA_LOADER.PIN_MEMORY False"

cd "$REPO_DIR"
mkdir -p "$REPO_DIR/joblogs"
exec > >(tee -a "$REPO_DIR/joblogs/${PBS_JOBNAME:-ek100}.${PBS_JOBID:-manual}.log") 2>&1
module load Miniconda3
conda activate testra 2>/dev/null || conda activate lstr
export PYTHONPATH=$PYTHONPATH:$(pwd)/src

# 1) Train the baseline (frame gate OFF by default).
python tools/train_net.py --config_file "$CONFIG" --gpu 0
TRAIN_EXIT=$?

if [ $TRAIN_EXIT -eq 0 ]; then
    echo "########## EVAL A: BASELINE (no reduction, N=64) ##########"
    python tools/test_net.py --config_file "$CONFIG" --gpu 0 \
        MODEL.CHECKPOINT "$CKPT" $EVAL_OPTS

    for K in 32 16; do
        echo "########## EVAL: FRAME GATE norm (TOP_K=$K / 64) ##########"
        python tools/test_net.py --config_file "$CONFIG" --gpu 0 \
            MODEL.CHECKPOINT "$CKPT" \
            MODEL.LSTR.FRAME_GATE.ENABLED True \
            MODEL.LSTR.FRAME_GATE.SCORE norm \
            MODEL.LSTR.FRAME_GATE.TOP_K $K \
            $EVAL_OPTS

        echo "########## EVAL: FRAME GATE uniform (TOP_K=$K / 64) ##########"
        python tools/test_net.py --config_file "$CONFIG" --gpu 0 \
            MODEL.CHECKPOINT "$CKPT" \
            MODEL.LSTR.FRAME_GATE.ENABLED True \
            MODEL.LSTR.FRAME_GATE.SCORE uniform \
            MODEL.LSTR.FRAME_GATE.TOP_K $K \
            $EVAL_OPTS
    done
else
    echo "Training failed (exit $TRAIN_EXIT); skipping eval."
fi

# Push logs (best-effort), matching the other jobs' workflow.
if [ -d "$HPC_RUN_DIR/.git" ]; then
    cd "$HPC_RUN_DIR"
    git add logs/ 2>/dev/null
    git commit -m "logs: $(date +"%Y-%m-%d_%H-%M-%S") job=${PBS_JOBID} exit=${TRAIN_EXIT} (EK100 gate)" 2>/dev/null
    git push origin main 2>/dev/null && echo "Logs pushed." || echo "git push failed; push from login node."
fi

exit $TRAIN_EXIT
