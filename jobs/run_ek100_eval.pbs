#!/bin/bash -l
#PBS -N ek100_eval
#PBS -l select=1:ncpus=4:ngpus=1:mem=128GB:gpu_id=A100
#PBS -l walltime=08:00:00
#PBS -m abe
#PBS -M n11429984@qut.edu.au
#PBS -j oe
#PBS -q gpu_batch_exec

# EVAL-ONLY: reuse the ALREADY-TRAINED EK100 baseline checkpoint and evaluate
# baseline / gate:norm / gate:uniform (keep 32 & 16), plus learned if present,
# then print the comparison table. No training (saves ~12h).
# Requires: the baseline epoch-30.pth to exist, and RULSTM utils.py + CSVs
# (run jobs/fetch_rulstm_ek100_csvs.sh first).

REPO_DIR=~/TeSTra
HPC_RUN_DIR=~/hpc_run
CONFIG=configs/EK100/TESTRA/testra_long_64_work_5_anti_2_kinetics_2x_mixup_v+n_eql_box.yaml
BASE_DIR=checkpoints/EK100/TESTRA/testra_long_64_work_5_anti_2_kinetics_2x_mixup_v+n_eql_box
BASE_CKPT=$BASE_DIR/epoch-30.pth
LEARNED_CKPT=$BASE_DIR/framegate_learned/epoch-30.pth
EVAL_OPTS="DATA_LOADER.BATCH_SIZE 4 DATA_LOADER.NUM_WORKERS 4 DATA_LOADER.PIN_MEMORY False"

cd "$REPO_DIR"
mkdir -p "$REPO_DIR/joblogs"
exec > >(tee -a "$REPO_DIR/joblogs/${PBS_JOBNAME:-ek100_eval}.${PBS_JOBID:-manual}.log") 2>&1
module load Miniconda3
conda activate testra 2>/dev/null || conda activate lstr
export PYTHONPATH=$PYTHONPATH:$(pwd)/src

RES="$REPO_DIR/joblogs/ek100_eval.${PBS_JOBID:-manual}.results.tsv"
printf "method\tkeep\tmAP\n" > "$RES"

run_eval () {
    local label="$1" keep="$2" ckpt="$3"; shift 3
    echo "########## EVAL: $label (keep=$keep) ##########"
    if [ ! -f "$ckpt" ]; then
        echo "  checkpoint missing ($ckpt) -- skipping"; printf "%s\t%s\tNA\n" "$label" "$keep" >> "$RES"; return
    fi
    local tmp=$(mktemp)
    python tools/test_net.py --config_file "$CONFIG" --gpu 0 \
        MODEL.CHECKPOINT "$ckpt" "$@" $EVAL_OPTS 2>&1 | tee "$tmp"
    local map=$(grep -aiE "perframe m" "$tmp" | tail -1 | grep -oE "[0-9]+\.[0-9]+" | tail -1)
    printf "%s\t%s\t%s\n" "$label" "$keep" "${map:-NA}" >> "$RES"
    rm -f "$tmp"
}

if [ ! -f "$BASE_CKPT" ]; then
    echo "ERROR: baseline checkpoint not found: $BASE_CKPT"
    echo "Train it first (run_ek100_all.pbs or run_ek100.pbs)."
    exit 1
fi

run_eval baseline 64 "$BASE_CKPT"
for K in 32 16; do
    run_eval "gate:norm"    $K "$BASE_CKPT" \
        MODEL.LSTR.FRAME_GATE.ENABLED True MODEL.LSTR.FRAME_GATE.SCORE norm    MODEL.LSTR.FRAME_GATE.TOP_K $K
    run_eval "gate:uniform" $K "$BASE_CKPT" \
        MODEL.LSTR.FRAME_GATE.ENABLED True MODEL.LSTR.FRAME_GATE.SCORE uniform MODEL.LSTR.FRAME_GATE.TOP_K $K
done
run_eval "gate:learned" 32 "$LEARNED_CKPT" \
    MODEL.LSTR.FRAME_GATE.ENABLED True MODEL.LSTR.FRAME_GATE.SCORE learned MODEL.LSTR.FRAME_GATE.TOP_K 32 \
    SESSION framegate_learned

echo
echo "################ EK100 FRAME-GATE COMPARISON (metric: mAP) ################"
awk -F'\t' '
  NR==1 { next }
  { name[NR]=$1; keep[NR]=$2; map[NR]=$3; order[++n]=NR; if($1=="baseline") base=$3+0 }
  END {
    printf "%-14s %-6s %-10s %-12s\n","method","keep","mAP","vs baseline"
    printf "%-14s %-6s %-10s %-12s\n","------","----","---","-----------"
    for(i=1;i<=n;i++){ r=order[i];
      d="-"; if(base>0 && map[r]!="NA") d=sprintf("%+.4f", (map[r]+0)-base);
      printf "%-14s %-6s %-10s %-12s\n", name[r], keep[r], map[r], d }
  }' "$RES"
echo "##########################################################################"
echo "(raw table: $RES)"

if [ -d "$HPC_RUN_DIR/.git" ]; then
    cd "$HPC_RUN_DIR"
    git add logs/ 2>/dev/null
    git commit -m "logs: $(date +"%Y-%m-%d_%H-%M-%S") job=${PBS_JOBID} (EK100 eval)" 2>/dev/null
    git push origin main 2>/dev/null && echo "Logs pushed." || echo "git push failed; push from login node."
fi
